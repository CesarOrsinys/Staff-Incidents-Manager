{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "mock_data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
